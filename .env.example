DATABASE_URL="postgresql://user:pass@host:5432/dbname"
# Opcional. Ausente = CORS desligado (produção via Nginx não precisa).
# Preencher só se o front chamar a API de uma origem diferente (ex.: dev
# local com o Next em outra porta). Várias origens, separadas por vírgula.
# CORS_ORIGIN="http://localhost:3001"
BREAK_GLASS_USER="resgate.local"
BREAK_GLASS_PASSWORD="minimo-16-caracteres"
AUTH_VALIDATOR="fake"
AD_URL="ldaps://dc.dominio"
AD_BASE_DN="DC=dominio"
AD_UPN_SUFFIX="dominio"
AD_CA_PATH="certs/ad-ldaps.pem"
AD_BIND_DN="svc-app@dominio"
AD_BIND_PASSWORD="senha-da-conta-de-servico"