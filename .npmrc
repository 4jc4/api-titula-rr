# engines (package.json) exige Node >=24 — mesma versão do Dockerfile
# (node:24-slim) e do node-version dos workflows de CI/CD. engine-strict
# faz o npm ci/install FALHAR de propósito se a versão do Node não bater,
# em vez de só avisar — evita instalação silenciosamente incompatível.
engine-strict=true
